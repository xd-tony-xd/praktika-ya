# =====================================================================
#  Secretos de las Edge Functions (NO se suben al frontend).
#  Copia este archivo a "supabase/.env", complétalo y ejecuta:
#     npx supabase secrets set --env-file supabase/.env
#  (SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los pone Supabase solo.)
# =====================================================================

# --- Obligatorio: IA (Google AI Studio -> Get API key) ---
GEMINI_API_KEY=
# Modelos en orden de preferencia (si uno falla se usa el siguiente)
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash

# --- Obligatorio: URL pública del frontend (Vercel/Netlify), sin "/" al final ---
APP_URL=https://tu-dominio.vercel.app
SITE_NAME=Práctika ya
# Opcional: restringe CORS a tu dominio (por defecto "*")
# ALLOWED_ORIGIN=https://tu-dominio.vercel.app

# --- Consulta RUC / DNI (apiperu.dev). Es el antiguo INTI_API_KEY ---
APIPERU_TOKEN=
APIPERU_URL=https://apiperu.dev/api

# --- Correo: usa UNA de las dos opciones ---
# Opción A (recomendada): Resend (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Práctika ya <no-responder@tu-dominio.com>
# Opción B: Gmail con contraseña de aplicación (puerto 465; Supabase bloquea el 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Pagos con Stripe (créditos IA) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
